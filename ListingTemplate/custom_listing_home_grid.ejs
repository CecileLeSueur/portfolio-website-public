<div class="card-row">

<% for (const item of items) { %>
  
<div class="card">

  <!-- Image -->
  <% if (item.image) { %>
  <img src="<%= item.image %>">
  <% } %>

  <!-- Title -->
  <h3>
    <p>
      <%= item["title-short"] || item.title %>
    </p>
  </h3>

  <!-- Description -->
  <p>
    <%= item["description-short"] || item.description %>
  </p>

</div>

<% } %>

</div>